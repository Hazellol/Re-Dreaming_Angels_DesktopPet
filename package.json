{
  "name": "re-dreaming-angels-desktop-pet",
  "version": "1.1.1",
  "description": "Dreaming Angels desktop pet (Airui / Qianxia / Nangong, source-level animation)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:portable": "electron-builder --win portable",
    "pack:installer": "electron-builder --win nsis",
    "pack:mac": "electron-builder --mac dmg"
  },
  "author": "master",
  "license": "MIT",
  "dependencies": {
    "@esotericsoftware/spine-canvas": "^4.2.42",
    "@esotericsoftware/spine-core": "^4.2.42",
    "koffi": "^3.3.0"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.master.re-dreaming-angels",
    "productName": "妄想天使桌宠",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md",
      "!tools",
      "!scripts",
      "!tts",
      "!tts_out",
      "!data"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "ReDreamingAngels-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "妄想天使桌宠",
      "artifactName": "ReDreamingAngels-Setup-${version}.exe"
    },
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "ReDreamingAngels-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "ReDreamingAngels-${version}-mac-${arch}.${ext}"
    }
  }
}
